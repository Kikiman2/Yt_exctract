# Copy to .env (scripts/setup.sh does it and generates SESSION_SECRET). docker compose
# reads it both for ${...} substitution in docker-compose.yml and as the app
# container's environment.

# Admin account. The app refuses to start without these. They are only used on the very first
# start, to create admin #1; after that the database owns the password (change it under
# Account, and add other users under Users). Later edits here are ignored.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Signs the session cookie. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# The session cookie is marked Secure automatically on HTTPS requests (direct, or via a proxy /
# Cloudflare tunnel sending X-Forwarded-Proto: https). true = always Secure, which also blocks
# plain-HTTP logins, so leave false if you also use http://<lan-ip>:2000 (see README, HTTPS).
COOKIE_SECURE=false
# Reverse proxy / tunnel IPs or CIDRs whose X-Forwarded-For is trusted for the login rate limit.
# Needed when published through a proxy or Cloudflare Tunnel, e.g. 172.16.0.0/12 (Docker bridges).
# Empty = use the direct peer.
TRUSTED_PROXIES=

# Host folder the videos are written to (your Jellyfin library root or a folder in it).
# Must contain the sentinel file .yt-extract-library (scripts/setup.sh creates it);
# without it nothing is written and the pipeline pauses.
MEDIA_ROOT=/srv/media

TZ=Europe/Budapest

# Jellyfin, reached from the app container through the docker host gateway.
# If that doesn't connect, try http://172.17.0.1:8096
JELLYFIN_URL=http://host.docker.internal:8096
# Dashboard -> Administration -> API Keys. Empty = Jellyfin integration off.
JELLYFIN_API_KEY=
# The library folder as Jellyfin's own container sees it.
JELLYFIN_LIBRARY_PATH=/data/YouTube
JELLYFIN_LIBRARY_NAME=YouTube

# bgutil PO-token sidecar. docker-compose.yml already points the app at the bundled
# container; only set this if you run the provider elsewhere (compose overrides it
# for the bundled one, so edit the compose file in that case).
POT_PROVIDER_URL=http://bgutil-provider:4416
